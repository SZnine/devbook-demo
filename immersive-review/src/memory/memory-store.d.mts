export type MemoryRead = { id: string; at: number; contentHash: string; sectionVersion: number; documentRevision: string; voidedAt?: number; source?: 'manual' | 'focus'; sessionId?: string; activeMs?: number; coverage?: number };
export type MemoryAiPriority = { score: number; reason: string; contentHash: string; goal: string; providerId: string; model: string; rubricVersion: string; scoredAt: number; rank?: number; populationSize?: number };
export type MemoryEntry = { id: string; documentId: string; sectionId: string; documentTitle: string; title: string; addedAt: number; active: boolean; trackingPaused?: boolean; events: MemoryRead[]; priority?: { manual?: number; ai?: MemoryAiPriority } };
export type MemoryReference = { documentId: string; sectionId: string; documentTitle: string; title: string; contentHash: string; documentRevision: string; sectionVersion: number };
export type MemorySettingsValue = { retentionScale: number; forgettingExponent?: number };
export const MEMORY_DB: string;
export const MEMORY_CHANGED_EVENT: string;
export const MEMORY_CHANGED_CHANNEL: string;
export const defaultMemorySettings: Readonly<MemorySettingsValue>;
export function memoryId(documentId: string, sectionId: string): string;
export function readMemoryState(): Promise<{ entries: MemoryEntry[]; settings: MemorySettingsValue }>;
export function enrollMemory(ref: MemoryReference, now?: number): Promise<MemoryEntry>;
export function removeMemory(id: string): Promise<MemoryEntry>;
export function recordManualRead(ref: MemoryReference, now?: number): Promise<MemoryEntry>;
export type MemoryExposure = { source: 'manual' | 'focus'; sessionId: string; activeMs?: number; coverage?: number };
export function recordMemoryExposure(ref: MemoryReference, exposure: MemoryExposure, now?: number): Promise<{ entry: MemoryEntry; recorded: boolean; eventId?: string }>;
export function saveMemoryPriority(id: string, manual?: number): Promise<MemoryEntry>;
export function saveMemoryAiPriority(id: string, assessment: MemoryAiPriority): Promise<MemoryEntry>;
export function saveMemoryAiPriorities(updates: { id: string; assessment: MemoryAiPriority }[]): Promise<MemoryEntry[]>;
export function undoMemoryRead(id: string, eventId: string, now?: number): Promise<MemoryEntry>;
export function saveMemorySettings(settings: MemorySettingsValue): Promise<MemorySettingsValue>;
