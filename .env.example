# Optional. docker compose up -d --build works without a .env file.
# Copy to .env to override values; never commit .env or real API keys.
# No built-in account authentication: keep loopback binding for personal use.
READ_BIND_ADDRESS=127.0.0.1
READ_PORT=5174

# Comma-separated exact browser origins; leave blank to match localhost + 127.0.0.1 at READ_PORT.
# For an authenticated reverse proxy, explicitly set its HTTPS origin here.
READ_ALLOWED_ORIGINS=
READ_AI_TIMEOUT_MS=180000
READ_MAX_BODY_BYTES=1048576

# Native Node runtime only (Compose fixes these to 0.0.0.0 and /data inside the container).
# READ_HOST=127.0.0.1
# READ_DATA_DIR=.local

# Optional initial provider configuration. The UI's saved settings take precedence after saving.
# Models are comma-separated. Empty values use application defaults.
# Prefer entering keys in Settings > AI service instead of putting them in a Compose environment.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODELS=
GLM_API_KEY=
GLM_BASE_URL=
GLM_MODELS=
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODELS=
